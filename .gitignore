# أندرويد / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/captures/
*.apk
*.aab
*.keystore
*.jks

# عوالم وأرشيفات كبيرة (تبقى محلياً)
*.zip
*.z01
*.z02
!supabase/functions/**

# بايثون (أدوات المشروع)
__pycache__/
*.pyc

# نظام
.DS_Store
Thumbs.db

# حزمة SQL الجاهزة (مقصود تعقّبها لتوفير رابط تحميل مباشر)
!sql-package/**

# مساحة عمل توليد الأكواد (تبقى محلياً حتى لا تُرفع سهواً)
redeem-codes/

# أكواد هدايا AC المرفوعة إلى المستودع **الخاص** لتنزيلها من GitHub
# (المستودع private — لا تجعل المستودع عاماً وأنت هذه الأكواد فيه)
# ac-codes/  ← متعقّب عمداً (مع استثناء ملف zip من قاعدة *.zip)
!ac-codes/*.zip
