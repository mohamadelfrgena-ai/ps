# ============================================================================
#  AddonStation Mobile — نموذج ملف android/local.properties
#  طريقة الاستخدام:  انسخ هذا الملف باسم  local.properties  في نفس المجلد
#                    (copy local.properties.example local.properties)
#  ⚠️  ملف local.properties مستثنى من Git — لا ترفعه ولا تشاركه مع أحد.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) مسار Android SDK على جهازك  (اضغط على الاسم فقط: sdk.dir)
#    أمثلة:
#      ويندوز:       sdk.dir=C\:\\Users\\<USERNAME>\\AppData\\Local\\Android\\Sdk
#      ماك/لينكس:    sdk.dir=/Users/<USERNAME>/Library/Android/sdk
# ---------------------------------------------------------------------------
sdk.dir=<SDK_PATH>

# ---------------------------------------------------------------------------
# 2) مفاتيح Supabase — اسم المتغير الأول: ADDONSTATION_SUPABASE_URL
#    ضع هنا رابط مشروعك فقط، مثال القيمة: https://<PROJECT-REF>.supabase.co
# ---------------------------------------------------------------------------
ADDONSTATION_SUPABASE_URL=

# ---------------------------------------------------------------------------
# 3) اسم المتغير الثاني: ADDONSTATION_SUPABASE_ANON_KEY
#    المفتاح العام فقط — يقبل النوعين:
#      • sb_publishable_...   (مفاتيح Supabase الجديدة 2026)
#      • anon  (مفتاح JWT القديم — sb_* ليست JWT)
# ---------------------------------------------------------------------------
ADDONSTATION_SUPABASE_ANON_KEY=

# ⛔ ممنوع تماماً وضع المفتاح السري هنا (sb_secret_...  أو  مفتاح service_role):
#    المفتاح السري يبقى في لوحة Supabase وفي أسرار السكربتات/الخادم فقط.
#    البناء (app/build.gradle.kts) يرفض الملف ويوقف الـbuild إن وجد أياً منهما،
#    وشاشة «إعداد أول تشغيل» داخل التطبيق ترفضهما أيضاً.
