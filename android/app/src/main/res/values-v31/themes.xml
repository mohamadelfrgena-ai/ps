<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) system splash: نفس خلفية شاشة Compose وبدون وميض أبيض
         عند الانتقال من شاشة النظام إلى شاشة Compose. -->
    <style name="Theme.AddonStation.Splash" parent="Theme.AddonStation">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/app_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>
</resources>
