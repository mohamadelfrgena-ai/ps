# ملف «طلب تشغيل الإشعارات» — مثل .build-request لكن للإشعارات (لا يبني أي APK).
#
#   enable: true   ← نفّذ ملفات الخادم بالترتيب: 35 (الإشعارات الحقيقية + الطابور)
#                     36 (إحصاءات الملف الشخصي) · 37 (الإبلاغ عن عضو) ·
#                     38 (كتم العضو: لا رسائل ولا إشعارات · ميزة Legendary)
#   deploy: true   ← انشر دالة الإرسال send-push من المودع
