# لتشغيله: عدّل هذا الملف ثم احفظ الالتزام (Commit changes) ⇒ يعمل سير
# «Push doctor» فوراً، ثم اقرأ الملخّص في صفحة التشغيل.
# لإيقافه: اكتب false في السطرين.
#
# آخر طلب: تنفيذ ملفات الخادم 36 · 37 · 38 + إعادة محاولة وطباعة النتيجة
# (التشغيل السابق فشل في الخطوة ولم نرَ السبب — الآن يُطبَع في صفحة التشغيل).

enable: true
deploy: true
run: 12
